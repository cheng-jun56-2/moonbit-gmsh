// Generated numeric fixtures: Gmsh4.15.2, tools/generate-high-order-fixture.py.
// Self-authored curved input coordinates. Gmsh is verification-only.

///|
fn qmesh(kind : Int, points : Array[Array[Double]]) -> @gmsh.Mesh raise {
  @gmsh.mesh(
    points.mapi((i, xyz) => {
      tag: i + 1,
      xyz,
      dim: -1,
      entity: 0,
      parameters: [],
    }),
    [
      {
        tag: 201,
        kind,
        nodes: [
          for i in 0..<points.length() => i + 1
        ],
        entity: 0,
        physical: [],
        extra: [],
      },
    ],
  )
}

///|
fn qclose(a : Double, b : Double) -> Unit raise {
  assert_true((a - b).abs() <= 1.0e-11)
}

