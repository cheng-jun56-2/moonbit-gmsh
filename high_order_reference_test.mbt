          [0.010573781836234595, 1.0211486440100086, 0.03914120222030356],
          [0.0005189896143160274, -0.00919476178820916, 0.9868526065997238],
        ],
        [
          [1.0057488702452102, 0.027151766192264337, 0.04433157000436061],
          [0.03259586654660947, 1.0160517103537041, 0.048293605508233806],
          [-0.025747745863158686, 0.01629654749910875, 1.0045216827327466],
        ],
        [
          [0.9731436896533002, 0.017506873334632383, 0.005465433434745273],
          [-0.011655090613852849, 1.00348666205657, -0.003681812597013126],
          [-0.016300470171087305, 0.00882371961751438, 1.0006635277951395],
        ],
        [
          [0.9986910941395902, 0.025895003304110487, 0.03714222758448782],
          [-0.008374889525849706, 1.015614500854787, 0.016658550499141722],
          [-0.0030051803766432523, -0.008446087670936242, 0.9852893207652156],
        ],
        [
          [0.9806851016043293, -0.0020770093151538105, -0.01766878817639181],
          [0.02999581133128525, 1.005857850528731, 0.031315648133370996],
          [0.012824929623884028, 0.005050355564139908, 1.0171380980905602],
        ],
        [
          [0.9965429160419863, -0.0005664087987925503, -0.0034490976047493183],
          [0.036405200291915005, 1.000607541183631, 0.02843238861531583],
          [-0.0224409901229818, 0.0022048058355549904, 0.9862718540478947],
        ],
      ],
      [
        [-0.5729363125824746, -0.5925350408767186, -0.5963721532584793],
        [-0.5930964292169789, -0.5924055664659205, 0.5432694652948349],
        [-0.5641965776649601, 0.5710561115001789, -0.5766691257551698],
        [-0.578762406876549, 0.5751563293920937, 0.5730513562482313],
        [0.572224110006897, -0.5737789719832317, -0.5759688148566857],
        [0.5610779874662837, -0.5735609460772202, 0.5706215968575393],
        [0.5828131300502383, 0.586316623252589, -0.5600144124710278],
        [0.5772612949325404, 0.590505392639717, 0.5966548626932844],
      ],
      [
        0.9688760059383613, 1.0168345909032817, 1.0137994544747375, 1.0259825014553672,
        0.9775103548273368, 0.9998332192921032, 1.0034680256161452, 0.9833398610558838,
      ],
    ),
  ]
  for (kind, points, ps, js, xyz, det) in cases {
    let report = qmesh(kind, points).sample_gauss_jacobians(201)
    assert_true(!report.globally_certified)
    assert_eq(report.samples.length(), ps.length())
    for sample in report.samples {
      let mut found = false
      for i, p in ps {
        if sample.reference
          .mapi((j, x) => (x - p[j]).abs() < 1.0e-10)
          .all(x => x) {
          found = true
          for j in 0..<3 {
            qclose(sample.xyz[j], xyz[i][j])
          }
          for j in 0..<report.dimension {
            for k in 0..<3 {
              qclose(sample.columns[j][k], js[i][j][k])
            }
          }
          qclose(sample.measure, det[i].abs())
          if report.dimension == 3 {
            qclose(sample.signed_jacobian.unwrap(), det[i])
          }
        }
      }
      assert_true(found)
    }
  }
}
