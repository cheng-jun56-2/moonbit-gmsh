import {
  "cheng-jun56/gmsh" @lib,
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "report",
        "transform",
        "new_file",
        "append_fields",
        "read_vtk_fields",
        "verify_vtk_fields",
        "verify_vtk_mesh",
      ],
      "format": "esm",
    },
  },
)
